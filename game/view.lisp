(in-package :slipstream)
(defvar *ui-scale* 1.0)
(defvar *ui-left* 0)
(defvar *ui-top* 0)
(defvar *help* nil)
(defvar *menu-time* 0.0)
(defvar *exit-request* nil)
(defun ux (x) (+ *ui-left* (* x *ui-scale*)))
(defun uy (y) (+ *ui-top* (* y *ui-scale*)))
(defun rect (x y w h c) (ss-rect (ux x) (uy y) (* w *ui-scale*) (* h *ui-scale*) c))
(defun line2 (x y bx by c) (ss-line (ux x) (uy y) (ux bx) (uy by) c))
(defun text2 (s x y size &optional (c #xEAF0F7FF)) (ss-text s (ux x) (uy y) (* size *ui-scale*) c))
(defun centered (s x y size &optional (c #xEAF0F7FF))
  (ss-text s (- (ux x) (/ (ss-measure s (* size *ui-scale*)) 2)) (uy y) (* size *ui-scale*) c))
(defun alpha-color (c a) (logior (logand c #xFFFFFF00) (round (* 255 (clamp a 0 1)))))
(defun panel (x y w h &optional (c #x0C1421E8))
  (rect x y w h c) (line2 x y (+ x w) y #x586D8166))
(defun button (s x y w h &optional (accent #x4AE5DAFF))
  (let* ((mx (/ (- (ss-cursor-x) *ui-left*) *ui-scale*))
         (my (/ (- (ss-cursor-y) *ui-top*) *ui-scale*))
         (hover (and (<= x mx (+ x w)) (<= y my (+ y h)))))
    (rect x y w h (if hover #x263B4FF0 #x132234EA))
    (rect x y 3 h accent)
    (centered s (+ x (/ w 2)) (+ y (/ (- h 22) 2)) 22 (if hover #xFFFFFFFF accent))
    (and hover (plusp (ss-click 0)))))
(defun box3 (p size c &optional glow)
  (funcall (if glow #'ss-glow #'ss-box) (v-x p) (v-y p) (v-z p) (v-x size) (v-y size) (v-z size) c))
(defun beam3 (a b radius c)
  (ss-beam (v-x a) (v-y a) (v-z a) (v-x b) (v-y b) (v-z b) radius c))
(defun sphere3 (p radius c) (ss-sphere (v-x p) (v-y p) (v-z p) radius c))

(defun render-arena ()
  (ss-box 0 -0.35 0 60 0.7 60 #x424F60FF)
  ;; Floor seams and guide lights make speed and wall distance readable.
  (loop for i from -26 to 26 by 4 do
    (ss-glow i 0.005 0 0.025 0.01 56 #x72809628)
    (ss-glow 0 0.006 i 56 0.01 0.025 #x72809628))
  (dolist (b *blocks*)
    (let* ((p (block-pos b)) (s (block-size b)) (top (v-y (box-max b))) (c (block-accent b)))
      (box3 p s (block-color b))
      (when (> (v-y s) 1)
        (ss-glow (v-x p) (+ top 0.015) (v-z p) (v-x s) 0.03 0.08 c)
        (when (< (v-x s) 15)
          (ss-glow (v-x p) (+ top 0.02) (- (v-z p) (/ (v-z s) 2)) (v-x s) 0.04 0.055 c)
          (ss-glow (v-x p) (+ top 0.02) (+ (v-z p) (/ (v-z s) 2)) (v-x s) 0.04 0.055 c)))))
  (dolist (side '(-1 1))
    (let ((c (if (= side -1) #x4AE5DAFF #xFFAA66FF)))
      (loop for i from -24 to 24 by 6 do
        (ss-box (* side 27.86) 6 i 0.3 12 0.42 #x263344FF)
        (ss-glow (* side 27.65) 7.5 i 0.04 3.6 0.07 c)
        (ss-box i 6 (* side 27.86) 0.42 12 0.3 #x263344FF)
        (ss-glow i 7.5 (* side 27.65) 0.07 3.6 0.04 c))
      (ss-box (* side 27) 12.8 0 1 0.6 56 #x253242FF)
      (ss-box 0 12.8 (* side 27) 56 0.6 1 #x253242FF)
      (ss-glow (* side 26.46) 12.9 0 0.04 0.08 54 c)
      (ss-glow 0 12.9 (* side 26.46) 54 0.08 0.04 c)
      (dolist (z '(-9 9))
        (ss-box (* side 9) 7.08 z 2.8 0.2 2.8 #x30394AFF)
        (ss-glow (* side 9) 3.5 (- z 1.22) 0.12 6 0.04 c))
      ;; Outside silhouettes and antennae, above the playable walls.
      (loop for i from -3 to 3 do
        (ss-box (* i 14) (+ 10 (* (abs i) 3)) (* side 43) 7 (+ 20 (* (abs i) 6)) 9 #x1D293BFF)
        (ss-glow (* i 14) (+ 23 (* (abs i) 4)) (* side 43) 0.1 4 0.1 #xB2C6DEFF))))
  (dolist (pad *pads*)
    (ss-glow (v-x pad) 0.035 (v-z pad) 3 0.07 3 #x2C4659FF)
    (ss-ring (v-x pad) 0.10 (v-z pad) 1.25 #x4AE5DAFF)
    (ss-ring (v-x pad) 0.11 (v-z pad) (+ 0.35 (* 0.7 (mod *menu-time* 1))) #x91FFF0FF)
    (ss-glow (v-x pad) 0.085 (v-z pad) 0.3 0.04 1.8 #x4AE5DAFF))
  (ss-ring 0 1.24 0 2.8 #xB78BFFFF)
  (ss-ring 0 1.25 0 2.45 #xB78BFF88)
  (dolist (item *pickups*)
    (let* ((p (pickup-pos item)) (kind (pickup-kind item))
           (c (case kind ((:health :mega) #x71EBB0FF) (:armor #xFFD47DFF) (:rail #xB78BFFFF) (:rockets #xFF6A43FF) (t #x4AE5DAFF))))
      (ss-ring (v-x p) (+ (v-y p) 0.02) (v-z p) 0.7 (alpha-color c 0.6))
      (when (<= (pickup-timer item) 0)
        (let* ((y (+ (v-y p) 0.7 (* 0.12 (sin (* *menu-time* 2.6)))))
               (orbit (* *menu-time* 1.5)))
          (ss-wire (v-x p) y (v-z p) 0.6 0.6 0.6 c)
          (case kind
            ((:health :mega) (ss-glow (v-x p) y (v-z p) 0.15 0.54 0.15 c)
                            (ss-glow (v-x p) y (v-z p) 0.54 0.15 0.15 c))
            (:armor (ss-sphere (v-x p) y (v-z p) 0.3 c))
            (t (ss-glow (v-x p) y (v-z p) 0.32 0.48 0.26 c)))
          (ss-sphere (+ (v-x p) (* 0.52 (cos orbit))) y (+ (v-z p) (* 0.52 (sin orbit))) 0.065 c)))))
  (dolist (a *actors*)
    (unless (or (eq a *player*) (> (actor-dead a) 0))
      (let ((p (actor-pos a)))
        (ss-bot (v-x p) (v-y p) (v-z p) (actor-yaw a) (actor-color a) (actor-walk a) (actor-weapon a))
        (when (> (actor-invuln a) 0) (ss-wire (v-x p) (+ (v-y p) 0.9) (v-z p) 1 1.9 1 #xA7E1FF66)))))
  (dolist (r *rockets*)
    (let ((p (rocket-pos r)))
      (sphere3 p 0.15 #xFFEAACFF)
      (beam3 p (v- p (v* (unit (rocket-vel r)) 0.9)) 0.055 #xFF785AFF)))
  (dolist (fx *effects*)
    (let* ((ratio (/ (effect-life fx) (effect-max-life fx))) (c (alpha-color (effect-color fx) ratio)))
      (case (effect-kind fx)
        (:beam (beam3 (effect-from fx) (effect-to fx) (effect-radius fx) c))
        (:spark (sphere3 (v+ (effect-from fx) (v* (v- (effect-to fx) (effect-from fx)) (- 1 ratio))) (* ratio 0.06) c))
        (:blast (let ((p (effect-from fx)) (r (* (- 1 ratio) (effect-radius fx))))
                  (ss-ring (v-x p) (max 0.06 (v-y p)) (v-z p) r c)
                  (sphere3 p (* r 0.35) (alpha-color (effect-color fx) (* 0.25 ratio)))))))))

(defun render-minimap ()
  (let ((x 38) (y 82) (size 128))
    (panel (- x 8) (- y 8) (+ size 16) (+ size 16) #x0B1420A8)
    (dolist (b *blocks*)
      (let ((lo (box-min b)) (s (block-size b)))
        (rect (+ x (* (/ (+ (v-x lo) 29) 58) size)) (+ y (* (/ (+ (v-z lo) 29) 58) size))
              (max 1 (* (/ (v-x s) 58) size)) (max 1 (* (/ (v-z s) 58) size)) #x6C80954C)))
    (dolist (a *actors*)
      (when (<= (actor-dead a) 0)
        (let* ((p (actor-pos a)) (px (+ x (* (/ (+ (v-x p) 29) 58) size))) (py (+ y (* (/ (+ (v-z p) 29) 58) size))))
          (when (or (eq a *player*) (< (distance3 p (actor-pos *player*)) 18))
            (ss-circle (ux px) (uy py) (* *ui-scale* (if (eq a *player*) 3 2)) (actor-color a))
            (when (eq a *player*)
              (let ((d (direction (actor-yaw a) 0))) (line2 px py (+ px (* 8 (v-x d))) (+ py (* 8 (v-z d))) #xFFFFFFFF)))))))))

(defun ranked () (stable-sort (copy-list *actors*) #'> :key #'actor-frags))
(defun render-scoreboard (&optional results)
  (panel 300 154 680 425 #x0A111EEE)
  (text2 (if results "MATCH COMPLETE" "ARENA STANDINGS") 330 180 29 #x4AE5DAFF)
  (text2 "PLAYER" 330 234 16 #x98A9BEFF)
  (text2 "FRAGS" 630 234 16 #x98A9BEFF)
  (text2 "DEATHS" 740 234 16 #x98A9BEFF)
  (text2 "K/D" 864 234 16 #x98A9BEFF)
  (loop for a in (ranked) for i from 0 do
    (let ((y (+ 274 (* i 36))))
      (when (eq a *player*) (rect 318 (- y 4) 644 34 #x4AE5DA16))
      (rect 330 (+ y 5) 5 14 (actor-color a))
      (text2 (actor-name a) 353 y 22 (actor-color a))
      (text2 (format nil "~D" (actor-frags a)) 648 y 22)
      (text2 (format nil "~D" (actor-deaths a)) 767 y 22)
      (text2 (format nil "~,1F" (/ (actor-kills a) (max 1 (actor-deaths a)))) 864 y 22)))
  (text2 (format nil "~A BOTS  /  ~D FRAG LIMIT  /  THE FOUNDRY" (aref #("ROOKIE" "VETERAN" "NIGHTMARE") *difficulty*) *frag-limit*) 330 550 15 #x8B9BB1FF))

(defun render-hud ()
  (let* ((a *player*) (w (actor-weapon a)) (speed (len (flat (actor-vel a))))
         (minutes (floor (max 0 *match-left*) 60)) (seconds (mod (floor (max 0 *match-left*)) 60)))
    (text2 "SLIPSTREAM" 30 24 23 #x4AE5DAFF)
    (text2 "THE FOUNDRY // FFA" 30 51 13 #x9CB0C8FF)
    (render-minimap)
    (text2 (format nil "~2,'0D M/S" (round speed)) 30 232 24 #xEAF0F7FF)
    (rect 30 264 144 3 #x34465AFF)
    (rect 30 264 (* 144 (/ (min speed 32) 32)) 3 #x4AE5DAFF)
    (text2 (if (> (actor-dash-cool a) 0) "DASH RECHARGING" "SHIFT / DASH READY") 30 279 12 #xAABCD2FF)
    (when (wall-normal (actor-pos a)) (text2 "SPACE / WALL KICK" 30 301 14 #x4AE5DAFF))
    (panel 510 22 260 48 #x0B1420BB)
    (centered (format nil "~2,'0D:~2,'0D  |  ~D / ~D" minutes seconds (actor-frags a) *frag-limit*) 640 35 23)
    (loop for entry in *feed* for i from 0 below 5 do
      (text2 (first entry) 962 (+ 28 (* i 24)) 16 (third entry)))
    (panel 30 607 266 78 #x0B1420E6)
    (rect 30 607 4 78 (if (< (actor-hp a) 30) #xFF785FFF #x4AE5DAFF))
    (text2 (format nil "~D" (max 0 (actor-hp a))) 48 615 43 (if (< (actor-hp a) 30) #xFF785FFF #xEAF0F7FF))
    (text2 "HEALTH" 50 663 12 #x93A7BDFF)
    (text2 (format nil "~D" (actor-armor a)) 182 622 32 #xFFD47DFF)
    (text2 "ARMOR" 184 662 12 #x93A7BDFF)
    (dotimes (i 4)
      (let ((x (+ 375 (* i 132))))
        (panel x 634 120 51 (if (= i w) #x223545F2 #x0B1420B0))
        (rect x 634 120 2 (if (= i w) (aref *weapon-colors* i) #x3B4C60FF))
        (text2 (format nil "~D  ~A" (1+ i) (aref #("ION" "SCATTER" "ROCKET" "RAIL") i)) (+ x 10) 646 13 (aref *weapon-colors* i))
        (text2 (format nil "~D" (aref (actor-ammo a) i)) (+ x 10) 665 13 #xAABCD2FF)))
    (panel 958 607 292 78 #x0B1420E6)
    (text2 (format nil "~D" (aref (actor-ammo a) w)) 976 614 43 (aref *weapon-colors* w))
    (text2 (aref *weapon-names* w) 978 663 12 #xAABCD2FF)
    (text2 (format nil "~D FPS" (ss-fps)) 1190 698 11 #x8396ACFF)
    (centered "TAB STANDINGS   F1 CONTROLS   ESC PAUSE   F11 FULLSCREEN" 640 700 11 #x9DAEC3FF)
    (let ((c (if (> *hit-flash* 0) #xFFCA79FF #xE8FAF2E6)) (gap (+ 6 (* (actor-recoil a) 4))))
      (line2 (- 640 gap 7) 360 (- 640 gap) 360 c) (line2 (+ 640 gap) 360 (+ 640 gap 7) 360 c)
      (line2 640 (- 360 gap 7) 640 (- 360 gap) c) (line2 640 (+ 360 gap) 640 (+ 360 gap 7) c)
      (rect 639 359 2 2 c)
      (when (> *hit-flash* 0)
        (line2 629 349 635 355 c) (line2 645 365 651 371 c)
        (line2 645 355 651 349 c) (line2 629 371 635 365 c)))
    (when (> *damage-flash* 0)
      (let ((c (alpha-color #xFF4A4AFF (* *damage-flash* 0.55))))
        (rect 0 0 1280 8 c) (rect 0 712 1280 8 c) (rect 0 0 8 720 c) (rect 1272 0 8 720 c)))
    (when (> *notice-time* 0) (centered *notice* 640 475 19 #x4AE5DAFF))
    (when (> (actor-dead a) 0)
      (rect 0 0 1280 720 #x10091788)
      (centered "FRAGGED" 640 303 51 #xFF785FFF)
      (centered (format nil "RESPAWNING IN ~,1F" (actor-dead a)) 640 372 21))
    (when (> (actor-invuln a) 0) (centered "SPAWN SHIELD / FIRING CANCELS PROTECTION" 640 510 13 #xA5D7FFFF))))

(defun render-controls ()
  (panel 320 130 640 410 #x0A1423F2)
  (text2 "MOVEMENT IS YOUR WEAPON" 350 160 27 #x4AE5DAFF)
  (loop for (key action) in '(("W A S D" "Move / strafe") ("MOUSE / LMB" "Look / fire")
                              ("SPACE" "Jump / hold to bunny hop") ("SPACE NEAR WALL" "Kick away while airborne")
                              ("SHIFT" "Dash in movement direction") ("1 2 3 4 / WHEEL" "Change weapon")
                              ("ROCKET AT FEET" "Rocket jump (costs health)") ("TAB / ESC" "Standings / pause"))
        for y from 216 by 35 do
    (text2 key 350 y 17 #xFFCE8BFF) (text2 action 595 y 17 #xCBD7E7FF))
  (centered "F1 TO CLOSE   //   CHAIN STRAFES AND WALL KICKS TO KEEP SPEED" 640 518 13 #x819AB6FF))

(defun cycle-bots () (setf *bot-count* (if (>= *bot-count* 6) 1 (1+ *bot-count*))))
(defun menu-input ()
  (dotimes (i 3) (when (pressed (+ 49 i)) (setf *difficulty* i)))
  (when (pressed 66) (cycle-bots))
  (when (pressed 76) (setf *frag-limit* (if (= *frag-limit* 20) 40 20)))
  (when (pressed 263) (setf *sensitivity* (max 0.0005 (- *sensitivity* 0.0002))))
  (when (pressed 262) (setf *sensitivity* (min 0.008 (+ *sensitivity* 0.0002))))
  (when (pressed 70) (setf *fov* (if (>= *fov* 110) 80 (+ *fov* 5))))
  (when (pressed 77) (setf *volume* (if (> *volume* 0) 0 0.65))))
(defun render-menu ()
  (ss-gradient 0 0 (ss-width) (ss-height) #x07101CEA #x0B15255C)
  (rect 68 114 42 4 #x4AE5DAFF)
  (text2 "OFFLINE ARENA / MOVEMENT FIRST" 68 142 16 #x8AB4C8FF)
  (text2 "SLIP" 64 190 102 #xFFFFFFFF)
  (text2 "STREAM" 64 281 102 #x4AE5DAFF)
  (text2 "SPEED. IMPACT. NO DOWNTIME." 70 400 21 #xCEDBEAFF)
  (text2 "The Foundry // an offline arena for one player" 70 442 15 #x9BB0C8FF)
  (text2 "Wall kicks. Air strafing. Rocket jumps." 70 470 16 #xB4C7DCFF)
  (text2 "Four weapons. No downloads. Just frag." 70 496 16 #xB4C7DCFF)
  (panel 764 146 444 454 #x0A1524E8)
  (text2 "QUICK MATCH" 792 172 28)
  (text2 "SELECT BOT SKILL" 792 222 13 #x93A9C2FF)
  (dotimes (i 3)
    (let ((x (+ 792 (* i 132))))
      (when (button (aref #("ROOKIE" "VETERAN" "NIGHTMARE") i) x 249 123 39 (if (= *difficulty* i) #x4AE5DAFF #x8297ADFF))
        (setf *difficulty* i))))
  (text2 (format nil "B  BOTS: ~D       L  FRAGS: ~D" *bot-count* *frag-limit*) 792 313 18)
  (text2 (format nil "< >  SENSITIVITY: ~,1F" (* *sensitivity* 1000)) 792 355 16 #xA2B7CEFF)
  (text2 (format nil "F  FOV: ~D       M  SOUND: ~A" (round *fov*) (if (> *volume* 0) "ON" "OFF")) 792 386 16 #xA2B7CEFF)
  (when (or (button "ENTER  /  START FRAGGING" 792 438 388 58) (pressed 257)) (start-match))
  (when (button "QUIT" 792 516 388 39 #x9CAEC4FF) (setf *exit-request* t))
  (text2 "WASD MOVE   MOUSE AIM   LMB FIRE" 70 591 17 #xE4EDF9FF)
  (text2 "SPACE JUMP / WALL KICK   SHIFT DASH" 70 621 17 #xE4EDF9FF)
  (text2 "1-4 WEAPONS   F1 ALL CONTROLS" 70 651 17 #xE4EDF9FF)
  (text2 "BUILT WITH COMMON LISP + SBCL / RAYLIB" 792 674 12 #x7E98B6FF))
(defun render-pause ()
  (rect 0 0 1280 720 #x050B15B0)
  (panel 433 208 414 306 #x0B1524F5)
  (centered "PAUSED" 640 234 36 #x4AE5DAFF)
  (when (or (button "ESC / RESUME" 462 301 356 51) (pressed 257))
    (setf *state* :playing) (ss-capture 1))
  (when (button "NEW MATCH" 462 368 356 51) (start-match))
  (when (button "MAIN MENU" 462 435 356 51 #xB5C5D9FF) (setf *state* :menu))
  (centered "F1 CONTROLS   /   M TO MUTE" 640 543 15 #xA3B6CEFF))
(defun render-results ()
  (rect 0 0 1280 720 #x070E1D99)
  (centered (if (eq (car (ranked)) *player*) "YOU OWN THE ARENA" (format nil "~A WINS" (actor-name (car (ranked))))) 640 87 38 #x4AE5DAFF)
  (render-scoreboard t)
  (when (or (button "ENTER / PLAY AGAIN" 340 617 290 52) (pressed 257)) (start-match))
  (when (button "MAIN MENU" 650 617 290 52 #xB4C5DDFF) (setf *state* :menu)))

(defun render-frame ()
  (setf *ui-scale* (min (/ (ss-width) 1280.0) (/ (ss-height) 720.0))
        *ui-left* (/ (- (ss-width) (* 1280 *ui-scale*)) 2)
        *ui-top* (/ (- (ss-height) (* 720 *ui-scale*)) 2))
  (ss-begin)
  (if (eq *state* :menu)
      (let* ((theta (+ 0.45 (* *menu-time* 0.06))) (p (v (* 23 (sin theta)) 16 (* 23 (cos theta))))
             (d (unit (v- (v 0 2 0) p))))
        (ss-camera (v-x p) (v-y p) (v-z p) (v-x d) (v-y d) (v-z d) 65 0))
      (let* ((p (eye *player*)) (speed (len (flat (actor-vel *player*))))
             (d (direction (actor-yaw *player*) (actor-pitch *player*)))
             (bob (if (actor-ground *player*) (* 0.035 (sin (actor-walk *player*))) 0))
             (fov (+ *fov* (* 0.35 (max 0 (- speed 12))))))
        (ss-camera (v-x p) (+ (v-y p) bob) (v-z p) (v-x d) (v-y d) (v-z d) fov (* *kick-flash* 0.05))))
  (render-arena)
  (when (and (not (eq *state* :menu)) (<= (actor-dead *player*) 0))
    (ss-weapon (actor-weapon *player*) (* 0.012 (sin (actor-walk *player*))) (actor-recoil *player*)))
  (ss-2d)
  (case *state*
    (:menu (render-menu))
    (:playing (render-hud) (when (down 258) (render-scoreboard)))
    (:paused (render-hud) (render-pause))
    (:results (render-results)))
  (when *help* (render-controls))
  (ss-end))
